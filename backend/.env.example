APP_NAME="Smart Attendance System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_attendance_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# =========================================================================
# Company HQ Geofencing & Anti-Spoofing Configuration
# =========================================================================
COMPANY_LATITUDE=30.044420
COMPANY_LONGITUDE=31.235712
GEOFENCE_RADIUS_METERS=100
MAX_ALLOWED_GPS_ACCURACY_METERS=30
JWT_SECRET=replace_with_a_secure_hmac_secret_key
ALLOW_SIMULATION=false

# =========================================================================
# Financial Penalties and Commitment Rewards (EGP)
# =========================================================================
RED_POINT_PENALTY_EGP=250
MONTHLY_BONUS_EGP=2500

# =========================================================================
# Traffic Light Time Windows (24-Hour Server Time HH:mm)
# =========================================================================
EARLY_WINDOW_START="07:00"
EARLY_WINDOW_END="09:00"
EARLY_BLACK_REDEMPTION_WINDOW_END="08:00"

NORMAL_WINDOW_START="09:00"
NORMAL_WINDOW_END="10:00"

LATE_WINDOW_START="10:00"
CHECKIN_CUTOFF_TIME="12:00"

# Consecutive early days needed to automatically convert 1 Black point -> Green point
BLACK_POINT_REDEMPTION_DAYS=5
